// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Define o provedor como SQLite
  url      = "file:./dev.db"

}

model usuarios {
  id                    Int                     @id @default(autoincrement())
  username              String
  nome                  String
  email                 String
  senha_hash            String
  foto_perfil_url       String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  lojas                 lojas[]
  avaliacoes_loja       avaliacoes_loja[]
  avaliacoes_produto    avaliacoes_produto[]
  comentarios_avaliacao comentarios_avaliacao[]
}

model imagens_produto {
  id         Int      @id @default(autoincrement())
  produto_id Int
  produto    produtos @relation(fields: [produto_id], references: [id])
  url_imagem String
  ordem      Int
}

model lojas {
  id              Int               @id @default(autoincrement())
  usuario_id      Int
  usuario         usuarios          @relation(fields: [usuario_id], references: [id])
  nome            String
  descricao       String?
  logo_url        String?
  banner_url      String?
  sticker_url     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  avaliacoes_loja avaliacoes_loja[]
  produtos        produtos[]
}

model avaliacoes_loja {
  id                    Int                     @id @default(autoincrement())
  usuario_id            Int
  usuario               usuarios                @relation(fields: [usuario_id], references: [id])
  loja_id               Int
  loja                  lojas                   @relation(fields: [loja_id], references: [id])
  nota                  Int
  comentario            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  comentarios_avaliacao comentarios_avaliacao[]
}

model categorias {
  id               Int          @id @default(autoincrement())
  nome             String
  categoria_pai_id Int?
  categoria_pai    categorias?  @relation("RelacaoSubcategorias", fields: [categoria_pai_id], references: [id])
  subcategorias    categorias[] @relation("RelacaoSubcategorias")
  produtos         produtos[]
}

model avaliacoes_produto {
  id                    Int                     @id @default(autoincrement())
  usuario_id            Int
  usuario               usuarios                @relation(fields: [usuario_id], references: [id])
  produto_id            Int
  produto               produtos                @relation(fields: [produto_id], references: [id])
  nota                  Int
  comentario            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  comentarios_avaliacao comentarios_avaliacao[]
}

model produtos {
  id                 Int                  @id @default(autoincrement())
  loja_id            Int?
  loja               lojas?                @relation(fields: [loja_id], references: [id])
  categoria_id       Int?
  categoria          categorias?           @relation(fields: [categoria_id], references: [id])
  nome               String
  descricao          String?
  preco              Float
  estoque            Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  imagens_produto    imagens_produto[]
  avaliacoes_produto avaliacoes_produto[]
}

model comentarios_avaliacao {
  id                   Int                 @id @default(autoincrement())
  usuario_id           Int
  usuario              usuarios            @relation(fields: [usuario_id], references: [id])
  avaliacao_loja_id    Int?
  avaliacao_loja       avaliacoes_loja?    @relation(fields: [avaliacao_loja_id], references: [id])
  avaliacao_produto_id Int?
  avaliacao_produto    avaliacoes_produto? @relation(fields: [avaliacao_produto_id], references: [id])
  conteudo             String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}
